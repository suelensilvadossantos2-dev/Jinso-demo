# The app runs fully in mock mode when OPENAI_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Opens the Talk to Us booking link in a new tab.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jinso-camilo/30min

# Optional limits for public real-AI usage.
AI_REQUESTS_PER_MINUTE=8
AI_SESSION_MESSAGE_LIMIT=30
